# PostgreSQL local (compose.yaml)
DATABASE_URL=postgresql://capela:capela_dev_password@localhost:5432/capela?schema=public

# Application and session
APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=capela_session
SESSION_TTL_HOURS=8

# Private documents
DOCUMENT_STORAGE_PATH=./storage

# Public chapel information
CHAPEL_NAME=Capela Comunitaria
CHAPEL_CONTACT_EMAIL=contato@example.org
CHAPEL_CONTACT_PHONE=5585999999999

# Development seed only; replace before running the seed
SEED_ADMIN_NAME=Administrador da Capela
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=change-this-development-password
