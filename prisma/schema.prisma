generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  GENERAL_ADMIN
  FINANCE
  INVENTORY_VOLUNTEER
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum LoginAttemptResult {
  SUCCESS
  INVALID_CREDENTIALS
  PENDING
  INACTIVE
  BLOCKED
}

enum AccessLinkPurpose {
  INVITE
  PASSWORD_RESET
  DONOR_ACCOUNT
}

enum AuditActorKind {
  USER
  DONOR_LINK
  PUBLIC
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
}

enum DonorRelationshipType {
  ONE_OFF
  RECURRING
  IN_KIND
}

enum RecordOrigin {
  PUBLIC
  IN_PERSON
  ADMIN
}

enum DonorReviewStatus {
  CLEAR
  PENDING_REVIEW
}

enum DonationType {
  ONE_OFF
  MONTHLY
}

enum PaymentMethod {
  PIX
  CARD
  CASH
  BOLETO
}

enum PaymentSimulationStatus {
  CREATED
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
}

enum DestinationType {
  PROJECT
  MOST_NEEDED
}

enum LedgerEntryType {
  INCOME
  EXPENSE
}

enum LedgerEntryStatus {
  PENDING
  CONFIRMED
}

enum RecurringSubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum InventoryUnit {
  KG
  UNIT
  LITER
}

enum InventoryItemStatus {
  ACTIVE
  INACTIVE
}

enum InventoryLotStatus {
  AVAILABLE
  EXHAUSTED
  DISCARDED
}

enum InventoryValuationSource {
  MANUAL
  AVERAGE_AT_RECEIPT
}

enum InventoryMovementType {
  DISTRIBUTION
  DISCARD
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(160)
  email               String               @db.VarChar(254)
  role                UserRole
  status              UserStatus           @default(PENDING)
  passwordHash        String?              @map("password_hash")
  failedLoginCount    Int                  @default(0) @map("failed_login_count") @db.SmallInt
  lastLoginAt         DateTime?            @map("last_login_at") @db.Timestamptz(6)
  blockedAt           DateTime?            @map("blocked_at") @db.Timestamptz(6)
  createdById         String?              @map("created_by") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           User?                @relation("UserCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdUsers        User[]               @relation("UserCreator")
  sessions            Session[]
  loginAttempts       LoginAttempt[]
  accessLinks         AccessLink[]         @relation("AccessLinkOwner")
  createdLinks        AccessLink[]         @relation("AccessLinkCreator")
  auditEvents         AuditEvent[]
  ledgerEntries       LedgerEntry[]        @relation("LedgerEntryCreator")
  acceptedItemUpdates AcceptedItemConfig[]
  inventoryLots       InventoryLot[]
  inventoryMovements  InventoryMovement[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ip         String?   @db.Inet
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String?            @map("user_id") @db.Uuid
  attemptedEmail String             @map("attempted_email") @db.VarChar(254)
  occurredAt     DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(6)
  ip             String?            @db.Inet
  userAgent      String?            @map("user_agent") @db.VarChar(512)
  result         LoginAttemptResult
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([attemptedEmail, occurredAt])
  @@index([userId, occurredAt])
  @@map("login_attempts")
}

model AccessLink {
  id          String            @id @default(uuid()) @db.Uuid
  purpose     AccessLinkPurpose
  tokenHash   String            @unique @map("token_hash") @db.Char(64)
  userId      String?           @map("user_id") @db.Uuid
  donorId     String?           @map("donor_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?         @map("revoked_at") @db.Timestamptz(6)
  createdById String?           @map("created_by") @db.Uuid
  user        User?             @relation("AccessLinkOwner", fields: [userId], references: [id], onDelete: Restrict)
  createdBy   User?             @relation("AccessLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)
  donor       Donor?            @relation(fields: [donorId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@index([donorId, purpose])
  @@map("access_links")
}

model AuditEvent {
  id          String         @id @default(uuid()) @db.Uuid
  actorUserId String?        @map("actor_user_id") @db.Uuid
  actorKind   AuditActorKind @map("actor_kind")
  action      String         @db.VarChar(100)
  entityType  String?        @map("entity_type") @db.VarChar(80)
  entityId    String?        @map("entity_id") @db.Uuid
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  outcome     AuditOutcome
  metadata    Json           @default("{}") @db.JsonB
  actorUser   User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_events")
}

model Project {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String                  @db.VarChar(120)
  status                 ProjectStatus           @default(ACTIVE)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  paymentSimulations     PaymentSimulation[]
  ledgerEntries          LedgerEntry[]
  recurringSubscriptions RecurringSubscription[]
  inventoryMovements     InventoryMovement[]

  @@index([status, name])
  @@map("projects")
}

model Donor {
  id                 String                  @id @default(uuid()) @db.Uuid
  name               String                  @db.VarChar(160)
  email              String?                 @db.VarChar(254)
  phone              String?                 @db.VarChar(20)
  document           String?                 @db.VarChar(14)
  relationshipType   DonorRelationshipType   @map("relationship_type")
  origin             RecordOrigin            @default(PUBLIC)
  reviewStatus       DonorReviewStatus       @default(CLEAR) @map("review_status")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  accessLinks        AccessLink[]
  paymentSimulations PaymentSimulation[]
  ledgerEntries      LedgerEntry[]
  subscriptions      RecurringSubscription[]
  receipts           DonationReceipt[]
  inventoryLots      InventoryLot[]

  @@index([email])
  @@index([phone])
  @@index([reviewStatus, createdAt])
  @@map("donors")
}

model PaymentSimulation {
  id                      String                  @id @default(uuid()) @db.Uuid
  idempotencyKey          String                  @unique @map("idempotency_key") @db.Uuid
  confirmationKey         String?                 @unique @map("confirmation_key") @db.Uuid
  donationType            DonationType            @map("donation_type")
  amount                  Decimal                 @db.Decimal(14, 2)
  currency                String                  @default("BRL") @db.Char(3)
  method                  PaymentMethod
  status                  PaymentSimulationStatus @default(CREATED)
  destinationType         DestinationType         @map("destination_type")
  projectId               String?                 @map("project_id") @db.Uuid
  submittedIdentity       Json?                   @map("submitted_identity") @db.JsonB
  donorId                 String?                 @map("donor_id") @db.Uuid
  ledgerEntryId           String?                 @unique @map("ledger_entry_id") @db.Uuid
  recurringSubscriptionId String?                 @unique @map("recurring_subscription_id") @db.Uuid
  expiresAt               DateTime                @map("expires_at") @db.Timestamptz(6)
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  project                 Project?                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  donor                   Donor?                  @relation(fields: [donorId], references: [id], onDelete: Restrict)
  ledgerEntry             LedgerEntry?            @relation("SimulationLedgerEntry", fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  recurringSubscription   RecurringSubscription?  @relation("SimulationSubscription", fields: [recurringSubscriptionId], references: [id], onDelete: Restrict)
  createdLedgerEntry      LedgerEntry?            @relation("LedgerEntrySimulation")
  createdSubscription     RecurringSubscription?  @relation("SubscriptionSimulation")

  @@index([status, expiresAt])
  @@index([donorId, createdAt])
  @@map("payment_simulations")
}

model LedgerEntry {
  id                  String             @id @default(uuid()) @db.Uuid
  type                LedgerEntryType
  amount              Decimal            @db.Decimal(14, 2)
  currency            String             @default("BRL") @db.Char(3)
  occurredOn          DateTime           @map("occurred_on") @db.Date
  donorId             String?            @map("donor_id") @db.Uuid
  destinationType     DestinationType    @map("destination_type")
  projectId           String?            @map("project_id") @db.Uuid
  method              PaymentMethod
  status              LedgerEntryStatus  @default(PENDING)
  origin              RecordOrigin
  paymentSimulationId String?            @unique @map("payment_simulation_id") @db.Uuid
  createdById         String?            @map("created_by") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt         DateTime?          @map("confirmed_at") @db.Timestamptz(6)
  donor               Donor?             @relation(fields: [donorId], references: [id], onDelete: Restrict)
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  paymentSimulation   PaymentSimulation? @relation("LedgerEntrySimulation", fields: [paymentSimulationId], references: [id], onDelete: Restrict)
  simulationResult    PaymentSimulation? @relation("SimulationLedgerEntry")
  createdBy           User?              @relation("LedgerEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  receipt             DonationReceipt?

  @@index([occurredOn, type, status])
  @@index([projectId, occurredOn])
  @@index([donorId, occurredOn])
  @@map("ledger_entries")
}

model RecurringSubscription {
  id                  String                      @id @default(uuid()) @db.Uuid
  donorId             String                      @map("donor_id") @db.Uuid
  amount              Decimal                     @db.Decimal(14, 2)
  currency            String                      @default("BRL") @db.Char(3)
  status              RecurringSubscriptionStatus @default(ACTIVE)
  method              PaymentMethod
  nextChargeDate      DateTime?                   @map("next_charge_date") @db.Date
  destinationType     DestinationType             @map("destination_type")
  projectId           String?                     @map("project_id") @db.Uuid
  paymentSimulationId String                      @unique @map("payment_simulation_id") @db.Uuid
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  donor               Donor                       @relation(fields: [donorId], references: [id], onDelete: Restrict)
  project             Project?                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  paymentSimulation   PaymentSimulation           @relation("SubscriptionSimulation", fields: [paymentSimulationId], references: [id], onDelete: Restrict)
  simulationResult    PaymentSimulation?          @relation("SimulationSubscription")

  @@index([donorId, status])
  @@index([nextChargeDate, status])
  @@map("recurring_subscriptions")
}

model DonationReceipt {
  id               String      @id @default(uuid()) @db.Uuid
  ledgerEntryId    String      @unique @map("ledger_entry_id") @db.Uuid
  donorId          String      @map("donor_id") @db.Uuid
  documentSnapshot String      @map("document_snapshot") @db.VarChar(14)
  generatedAt      DateTime    @default(now()) @map("generated_at") @db.Timestamptz(6)
  filePath         String      @map("file_path") @db.Text
  contentSha256    String      @map("content_sha256") @db.Char(64)
  ledgerEntry      LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  donor            Donor       @relation(fields: [donorId], references: [id], onDelete: Restrict)

  @@index([donorId, generatedAt])
  @@map("donation_receipts")
}

model InventoryItem {
  id               String              @id @default(uuid()) @db.Uuid
  name             String              @db.VarChar(120)
  category         String              @db.VarChar(80)
  unit             InventoryUnit
  averageUnitValue Decimal             @map("average_unit_value") @db.Decimal(14, 2)
  status           InventoryItemStatus @default(ACTIVE)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  acceptedConfig   AcceptedItemConfig?
  lots             InventoryLot[]

  @@index([status, name])
  @@map("inventory_items")
}

model AcceptedItemConfig {
  itemId      String        @id @map("item_id") @db.Uuid
  accepted    Boolean       @default(true)
  priority    Boolean       @default(false)
  updatedById String        @map("updated_by") @db.Uuid
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  updatedBy   User          @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("accepted_item_configs")
}

model InventoryLot {
  id                String                   @id @default(uuid()) @db.Uuid
  itemId            String                   @map("item_id") @db.Uuid
  receivedQuantity  Decimal                  @map("received_quantity") @db.Decimal(14, 3)
  availableQuantity Decimal                  @map("available_quantity") @db.Decimal(14, 3)
  receivedOn        DateTime                 @map("received_on") @db.Date
  expiresOn         DateTime?                @map("expires_on") @db.Date
  donorId           String?                  @map("donor_id") @db.Uuid
  donorNameSnapshot String?                  @map("donor_name_snapshot") @db.VarChar(160)
  estimatedValue    Decimal                  @map("estimated_value") @db.Decimal(14, 2)
  valuationSource   InventoryValuationSource @map("valuation_source")
  unitValueSnapshot Decimal?                 @map("unit_value_snapshot") @db.Decimal(14, 2)
  status            InventoryLotStatus       @default(AVAILABLE)
  version           Int                      @default(1)
  createdById       String                   @map("created_by") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  item              InventoryItem            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  donor             Donor?                   @relation(fields: [donorId], references: [id], onDelete: Restrict)
  createdBy         User                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  movementLines     InventoryMovementLine[]
  term              InKindDonationTerm?

  @@index([itemId, status, expiresOn, receivedOn])
  @@index([status, expiresOn])
  @@map("inventory_lots")
}

model InventoryMovement {
  id          String                  @id @default(uuid()) @db.Uuid
  type        InventoryMovementType
  occurredOn  DateTime                @map("occurred_on") @db.Date
  projectId   String?                 @map("project_id") @db.Uuid
  reason      String?                 @db.Text
  note        String?                 @db.Text
  createdById String                  @map("created_by") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  project     Project?                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy   User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines       InventoryMovementLine[]

  @@index([occurredOn, type])
  @@index([projectId, occurredOn])
  @@map("inventory_movements")
}

model InventoryMovementLine {
  id         String            @id @default(uuid()) @db.Uuid
  movementId String            @map("movement_id") @db.Uuid
  lotId      String            @map("lot_id") @db.Uuid
  quantity   Decimal           @db.Decimal(14, 3)
  lotVersion Int               @map("lot_version")
  movement   InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  lot        InventoryLot      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([movementId, lotId])
  @@index([lotId])
  @@map("inventory_movement_lines")
}

model InKindDonationTerm {
  id                     String       @id @default(uuid()) @db.Uuid
  lotId                  String       @unique @map("lot_id") @db.Uuid
  descriptionSnapshot    String       @map("description_snapshot") @db.Text
  estimatedValueSnapshot Decimal      @map("estimated_value_snapshot") @db.Decimal(14, 2)
  donorSnapshot          Json         @map("donor_snapshot") @db.JsonB
  generatedAt            DateTime     @default(now()) @map("generated_at") @db.Timestamptz(6)
  filePath               String       @map("file_path") @db.Text
  contentSha256          String       @map("content_sha256") @db.Char(64)
  lot                    InventoryLot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@map("in_kind_donation_terms")
}
