generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  GENERAL_ADMIN
  FINANCE
  INVENTORY_VOLUNTEER
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum LoginAttemptResult {
  SUCCESS
  INVALID_CREDENTIALS
  PENDING
  INACTIVE
  BLOCKED
}

enum AccessLinkPurpose {
  INVITE
  PASSWORD_RESET
  DONOR_ACCOUNT
}

enum AuditActorKind {
  USER
  DONOR_LINK
  PUBLIC
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
}

model User {
  id               String          @id @default(uuid()) @db.Uuid
  name             String          @db.VarChar(160)
  email            String          @db.VarChar(254)
  role             UserRole
  status           UserStatus      @default(PENDING)
  passwordHash     String?         @map("password_hash")
  failedLoginCount Int             @default(0) @map("failed_login_count") @db.SmallInt
  lastLoginAt      DateTime?       @map("last_login_at") @db.Timestamptz(6)
  blockedAt        DateTime?       @map("blocked_at") @db.Timestamptz(6)
  createdById      String?         @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        User?           @relation("UserCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdUsers     User[]          @relation("UserCreator")
  sessions         Session[]
  loginAttempts    LoginAttempt[]
  accessLinks      AccessLink[]    @relation("AccessLinkOwner")
  createdLinks     AccessLink[]    @relation("AccessLinkCreator")
  auditEvents      AuditEvent[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ip        String?   @db.Inet
  userAgent String?   @map("user_agent") @db.VarChar(512)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String?            @map("user_id") @db.Uuid
  attemptedEmail String             @map("attempted_email") @db.VarChar(254)
  occurredAt     DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(6)
  ip             String?            @db.Inet
  userAgent      String?            @map("user_agent") @db.VarChar(512)
  result         LoginAttemptResult
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([attemptedEmail, occurredAt])
  @@index([userId, occurredAt])
  @@map("login_attempts")
}

model AccessLink {
  id          String            @id @default(uuid()) @db.Uuid
  purpose     AccessLinkPurpose
  tokenHash   String            @unique @map("token_hash") @db.Char(64)
  userId      String?           @map("user_id") @db.Uuid
  donorId     String?           @map("donor_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?         @map("revoked_at") @db.Timestamptz(6)
  createdById String?           @map("created_by") @db.Uuid
  user        User?             @relation("AccessLinkOwner", fields: [userId], references: [id], onDelete: Restrict)
  createdBy   User?             @relation("AccessLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@index([donorId, purpose])
  @@map("access_links")
}

model AuditEvent {
  id          String         @id @default(uuid()) @db.Uuid
  actorUserId String?        @map("actor_user_id") @db.Uuid
  actorKind   AuditActorKind @map("actor_kind")
  action      String         @db.VarChar(100)
  entityType  String?        @map("entity_type") @db.VarChar(80)
  entityId    String?        @map("entity_id") @db.Uuid
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  outcome     AuditOutcome
  metadata    Json           @default("{}") @db.JsonB
  actorUser   User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_events")
}

model Project {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(120)
  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, name])
  @@map("projects")
}
